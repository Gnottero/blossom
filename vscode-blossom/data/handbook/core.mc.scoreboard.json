{
  "$alias": "score",

  "scoreboard": {
    "signatures": ["scoreboard()", "scoreboard(objective)", "scoreboard(objective, who)", "scoreboard(objective, who, value)"],
    "summary": "Reads the objectives, the scores of one, the score of somebody, or writes it.",
    "params": [["objective", "the name of the objective"], ["who", "a player, an entity, or any name"], ["value", "optional: the score to write"]],
    "returns": "`list` of objectives, `map` of scores, `num` of a single score, or the previous value when writing.",
    "examples": ["score.scoreboard();                       // the existing objectives", "score.scoreboard('points');               // {'ada' -> 10, 'bob' -> 3}", "score.scoreboard('points', player);       // 10", "score.scoreboard('points', player, 20);   // writes it"]
  },
  "scoreboard_add": {
    "signatures": ["scoreboard_add(objective)", "scoreboard_add(objective, criterion)"],
    "summary": "Creates an objective.",
    "params": [["objective", "the name to give it"], ["criterion", "optional: what feeds it, `'dummy'` by default"]],
    "returns": "`bool` — whether it was created.",
    "examples": ["score.scoreboard_add('points');", "score.scoreboard_add('deaths', 'deathCount');"]
  },
  "scoreboard_remove": {
    "signatures": ["scoreboard_remove(objective)", "scoreboard_remove(objective, who)"],
    "summary": "Deletes an objective, or removes the score of a single one from it.",
    "params": [["objective", "the objective to work on"], ["who", "optional: only their score goes away"]],
    "returns": "`bool` — whether something was removed.",
    "examples": ["score.scoreboard_remove('points');            // the whole objective", "score.scoreboard_remove('points', player);    // only that score"]
  },
  "scoreboard_property": {
    "signatures": ["scoreboard_property(objective, property)", "scoreboard_property(objective, property, value)"],
    "summary": "Reads or writes a property of an objective.",
    "params": [["objective", "the objective"], ["property", "`'display_name'`, `'criterion'`, `'render_type'`"], ["value", "optional: what to write"]],
    "returns": "the value of the property, or the new one when writing.",
    "examples": ["score.scoreboard_property('points', 'display_name', text.format('gb Points'));", "score.scoreboard_property('points', 'render_type', 'hearts');"]
  },
  "scoreboard_display": {
    "signatures": ["scoreboard_display(slot)", "scoreboard_display(slot, objective)"],
    "summary": "Shows an objective in a display slot, or reads which one is there.",
    "params": [["slot", "`'sidebar'`, `'list'`, `'belowName'`, or `'sidebar.team.<colour>'`"], ["objective", "optional: the objective to show; `null` clears the slot"]],
    "returns": "`str` — the objective in that slot.",
    "examples": ["score.scoreboard_display('sidebar', 'points');", "score.scoreboard_display('sidebar', null);      // clears it"]
  },
  "team_list": {
    "signatures": ["team_list()", "team_list(team)"],
    "summary": "The teams that exist, or the members of one.",
    "params": [["team", "optional: the team to look inside"]],
    "returns": "`list` — the names of the teams, or of the members.",
    "examples": ["score.team_list();          // ['red', 'blue']", "score.team_list('red');     // ['ada', 'bob']"]
  },
  "team_add": {
    "signatures": ["team_add(team)", "team_add(team, who)"],
    "summary": "Creates a team, or puts somebody in it.",
    "params": [["team", "the name of the team"], ["who", "optional: the player or the name to add"]],
    "returns": "`bool` — whether something changed.",
    "examples": ["score.team_add('red');", "score.team_add('red', player);"]
  },
  "team_remove": {
    "signatures": ["team_remove(team)"],
    "summary": "Disbands a team.",
    "params": [["team", "the team to remove"]],
    "returns": "`bool` — whether it existed.",
    "examples": ["score.team_remove('red');"]
  },
  "team_leave": {
    "signatures": ["team_leave(who)"],
    "summary": "Takes somebody out of whatever team they are in.",
    "params": [["who", "the player or the name"]],
    "returns": "`bool` — whether they were in one.",
    "examples": ["score.team_leave(player);"]
  },
  "team_property": {
    "signatures": ["team_property(team, property)", "team_property(team, property, value)"],
    "summary": "Reads or writes a property of a team.",
    "params": [["team", "the team"], ["property", "`'collisionRule'`, `'color'`, `'displayName'`, `'friendlyFire'`, `'nametagVisibility'`, `'deathMessageVisibility'`, `'prefix'`, `'suffix'`, `'seeFriendlyInvisibles'`"], ["value", "optional: what to write"]],
    "returns": "the value of the property.",
    "examples": ["score.team_property('red', 'color', 'red');", "score.team_property('red', 'friendlyFire', false);"]
  },
  "bossbar": {
    "signatures": ["bossbar()", "bossbar(name)", "bossbar(name, property)", "bossbar(name, property, value)"],
    "summary": "The boss bars that exist, the creation of one, and its properties.",
    "params": [["name", "the id of the bar"], ["property", "`'name'`, `'color'`, `'style'`, `'value'`, `'max'`, `'visible'`, `'players'`, `'add_player'`, `'remove'`"], ["value", "optional: what to write"]],
    "returns": "`list` of the bars, the value of the property, or the created bar.",
    "examples": ["score.bossbar('mine:timer');                                // creates it", "score.bossbar('mine:timer', 'name', text.format('yb Time'));", "score.bossbar('mine:timer', 'max', 300);", "score.bossbar('mine:timer', 'value', left);", "score.bossbar('mine:timer', 'players', entity.player('all'));", "score.bossbar('mine:timer', 'remove');"]
  }
}
