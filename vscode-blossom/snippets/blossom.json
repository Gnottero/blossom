{
    "module": {
        "prefix": "module",
        "body": [
            "module ${1:name};",
            "",
            "$0"
        ],
        "description": "The module declaration at the top of the file"
    },
    "import": {
        "prefix": "import",
        "body": "import \"${1:core.list}\" as ${2:list};",
        "description": "An import with an alias (the alias is mandatory)"
    },
    "function": {
        "prefix": "fn",
        "body": [
            "fn ${1:name}(${2:args}) -> (",
            "\t$0",
            ");"
        ],
        "description": "A function private to the module"
    },
    "public function": {
        "prefix": "pubfn",
        "body": [
            "pub fn ${1:name}(${2:args}) -> (",
            "\t$0",
            ");"
        ],
        "description": "A function exported by the module"
    },
    "binding": {
        "prefix": "let",
        "body": "let ${1:name} = ${0};",
        "description": "An immutable binding"
    },
    "mutable binding": {
        "prefix": "letmut",
        "body": "let mut ${1:name} = ${0};",
        "description": "A binding that can be reassigned"
    },
    "event handler": {
        "prefix": "on",
        "body": [
            "fn ${1:handle}(${2:player}) -> (",
            "\t$0",
            "\tfalse",
            ");",
            "",
            "event.on('${3:player_connects}', ${1:handle});"
        ],
        "description": "A function registered on an event (false = do not cancel)"
    },
    "try": {
        "prefix": "try",
        "body": "try(${1:code}, '${2:value_exception}', ${0:handling});",
        "description": "Catches a thrown exception, by type"
    },
    "if": {
        "prefix": "if",
        "body": "if(${1:condition}, ${2:then}, ${0:otherwise})",
        "description": "Conditional (it is an expression, it returns a value)"
    },
    "for": {
        "prefix": "for",
        "body": "for(${1:list}, ${0:_});",
        "description": "Iterates over a list: _ is the element, _i the index"
    },
    "while": {
        "prefix": "while",
        "body": "while(${1:condition}, ${2:1000}, ${0:body});",
        "description": "Loop with a limit on the iterations"
    },
    "map": {
        "prefix": "map",
        "body": "list.map(${1:list}, ${0:_ * 2})",
        "description": "Transforms a list"
    },
    "task": {
        "prefix": "task",
        "body": "task.start(fn() -> (\n\t$0\n));",
        "description": "Long work on its own thread, outside the budget of the tick"
    },
    "lambda": {
        "prefix": "fn(",
        "body": "fn(${1:x}) -> ${0:x}",
        "description": "A function without a name, which captures the frame it is born in"
    },
    "match": {
        "prefix": "match",
        "body": [
            "match(${1:subject},",
            "\t${2:0}    -> ${3:'zero'},",
            "\telse -> ${0:null})"
        ],
        "description": "One subject, evaluated once, and the first arm that fits"
    },
    "pipe": {
        "prefix": "|>",
        "body": "${1:value}\n\t|> ${2:list.filter}(${3:fn(x) -> x})\n\t|> ${0:list.map}(fn(x) -> x);",
        "description": "a |> f(b) is f(a, b): the chain read in the order it happens"
    },
    "interpolation": {
        "prefix": "\"${",
        "body": "\"${1:text} \\${${2:expression}}\"",
        "description": "An interpolated string (double quotes interpolate, single ones do not)"
    },
    "manifest": {
        "prefix": "blossom.json",
        "body": [
            "{",
            "  \"name\": \"${1:name}\",",
            "  \"version\": \"0.1.0\",",
            "  \"entrypoint\": \"src/main.bs\",",
            "  \"api_level\": \"2.0\"",
            "}"
        ],
        "description": "The manifest of a project"
    }
}
