module registro;

import "core.list" as list;
import "core.map" as map;
import "core.io" as io;
import "core.task" as task;

// The app's state, and the disk. No other module writes in here directly: you go through these
// functions, which are the only place where saving can be forgotten.

let mut vene = [];              // [{'tipo' -> str, 'pos' -> [x,y,z], 'rimasti' -> n, 'chi' -> str}]
let mut totali = {};            // tipo -> how many blocks of that type have been broken

// Writes also arrive from a task, i.e. from another thread: a read-modify-write sequence
// isn't atomic, and needs to go inside a critical section.
let LOCK = 'registro';

// The 'data' root exists on every server; the subfolder named after the app keeps its data
// separate from the others.
let FILE = 'vena-viva/registro.json';

pub fn carica() -> (
    salvato = if(io.exists('data', FILE), io.read_json('data', FILE), {});
    vene = salvato:'vene' || [];
    totali = salvato:'totali' || {};
    list.size(vene)
);

pub fn salva() -> (
    io.write_json('data', FILE, {'vene' -> vene, 'totali' -> totali});
    false
);

pub fn annota(tipo: str, pos: list, rimasti: num, chi: str) -> task.synchronize(LOCK, (
    list.put(vene, null, {'tipo' -> tipo, 'pos' -> pos, 'rimasti' -> rimasti, 'chi' -> chi});
    totali:tipo = (totali:tipo || 0) + 1;
    list.size(vene)
));

pub fn quante() -> list.size(vene);

pub fn tutte() -> vene;

pub fn totale(tipo: str) -> totali:tipo || 0;

pub fn riepilogo() -> list.map(
    list.sort(map.pairs(totali), -(_:1)),
    _:0 + ': ' + _:1
);

pub fn svuota() -> task.synchronize(LOCK, (
    vene = [];
    totali = {};
    salva();
    'registro azzerato'
));
