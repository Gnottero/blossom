module worksite;

import "core.list" as list;
import "core.mc.block" as block;
import "core.mc.effect" as effect;
import "core.mc.scan" as scan;
import "core.mc.text" as text;

// Everything that touches the world lives here: reading blocks, showing particles, talking to
// players. The rest of the app calls these functions and doesn't know how they work inside.

pub let RADIUS = 6;

// Reads a cube around the center and returns a list of [position, block].
// Called from inside a task, it must be wrapped in task.dock by the caller: we don't do that here,
// because a function that decides on its own how to be scheduled is a function that can't be
// reused from the main thread.
pub fn read_around(center: list, radius: num) -> list.map(
    scan.rect(center, radius),
    [_, block.block(_) + '']
);

// The box around the vein, to show what the script looked at.
pub fn show_bounds(corners, particle: str) -> if(
    corners == null, 0,
    effect.particle_box(particle, corners:0, corners:1, 1)
);

pub fn play_depleted(pos: list) -> effect.sound('block.amethyst_block.break', pos, 1, 0.6);

pub fn notify(player, type: str, left: num, word: str) -> text.hud(
    player,
    text.format(
        'g vein of ', 'w ' + type,
        'g   left ', color_of(left) + ' ' + left,
        'g   (' + word + ')'
    ),
    100         // ticks: the line goes away on its own after five seconds
);

// private: the color scale is a presentation choice, not information
fn color_of(left) -> if(left == 0, 'r', left <= 2, 'y', 'l');
