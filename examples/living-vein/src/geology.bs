module geology;

import "core.list" as list;
import "core.string" as string;

// The part that thinks. Doesn't touch the world, doesn't print anything, doesn't listen to events:
// it takes a list of readings [position, block] and answers questions. It's the module you test with
//
//     /blossom script in living-vein geology.count([[[0, 0, 0], 'diamond_ore']], 'diamond_ore')
//
// without having to break a real block.

pub let ORES = [
    'coal_ore', 'deepslate_coal_ore',
    'iron_ore', 'deepslate_iron_ore',
    'copper_ore', 'deepslate_copper_ore',
    'gold_ore', 'deepslate_gold_ore',
    'redstone_ore', 'deepslate_redstone_ore',
    'lapis_ore', 'deepslate_lapis_ore',
    'diamond_ore', 'deepslate_diamond_ore',
    'emerald_ore', 'deepslate_emerald_ore',
    'nether_gold_ore', 'nether_quartz_ore', 'ancient_debris'
];

// 'minecraft:diamond_ore' and 'diamond_ore' are the same block written two ways: an id can arrive
// with its namespace, whoever writes a script uses the short form
pub fn short_name(block) -> (
    pieces = string.split(':', block + '');
    pieces:(list.size(pieces) - 1)
);

// '~' on a list returns the index, or null if it's not there: comparing with null is mandatory,
// because index 0 is a falsy value. 'list.has' is unrelated: that one asks whether the index exists.
pub fn is_ore(block) -> (ORES ~ short_name(block)) != null;

// How many readings are of the given type. 'for' returns how many times the body evaluated true,
// so counting doesn't need an accumulator.
pub fn count(readings: list, type: str) -> for(readings, short_name(_:1) == type);

// The positions of the readings of that type.
pub fn positions(readings: list, type: str) -> list.map(
    list.filter(readings, short_name(_:1) == type),
    _:0
);

// The corners of the box that contains all the given positions, or null if the list is empty.
// Used to draw the box around the vein.
pub fn bounds(points: list) -> (
    if(list.size(points) == 0, return(null));
    [
        [extreme(points, 0, false), extreme(points, 1, false), extreme(points, 2, false)],
        [extreme(points, 0, true),  extreme(points, 1, true),  extreme(points, 2, true)]
    ]
);

// private: it's a detail of 'bounds', and no other module should depend on it
fn extreme(points, axis, highest) -> (
    sorted = list.sort(list.map(points, _:axis));
    if(highest, sorted:(list.size(sorted) - 1), sorted:0)
);

// The verdict on the vein in one word: it's what the rest of the app shows to the player.
pub fn verdict(left: num) -> if(
    left == 0, 'depleted',
    left <= 2, 'nearly gone',
    left <= 8, 'good',
    'rich'
);
