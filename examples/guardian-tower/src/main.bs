module main;

import "tower/construction" as construction;
import "tower/registry" as registry;
import "core.mc.block" as block;
import "core.mc.system" as system;
import "core.mc.entity" as entity;
import "core.mc.text" as text;
import "core.mc.event" as event;
import "core.list" as list;

// Builds a lit tower where a bell is rung, and keeps count of the ones
// built. Shows: multiple modules, private symbols, a cancellable event, and a try/catch.

fn on_bell(pos, direction, who) -> (
    light = block.light(pos);
    height = construction.suggested_height(light);
    try(
        construction.build([pos:0, pos:1 + 1, pos:2], height);
        registry.add(pos, height);
        for(entity.player('all'), text.send(_, 'tower number ' + registry.count() + ' at ' + pos)),

        // 'exception' and not the short form: without a filter, try only catches what throw() raises,
        // and a nonexistent block or a position outside the loaded world wouldn't pass through it.
        'exception',

        // If the construction fails, for example because the position is outside the loaded world,
        // the event must not cancel the bell sound nor interrupt the other apps.
        // The thrown value is in '_', and must be copied right away: inside the 'for' that name is
        // already taken by the current element.
        (
            reason = _;
            for(entity.player('all'), text.send(_, 'could not build the tower: ' + reason))
        )
    );
    false   // false = the bell sound proceeds normally
);

pub fn tower_count() -> registry.count();

pub fn demolish_all() -> (
    list.map(registry.all(), construction.dismantle(_:0, _:1));
    registry.clear()
);

event.on('bell_rings', on_bell);
print('guardian-tower ready in ' + system.info('source_dimension'));
