module main;

import "core.mc.event" as event;
import "core.mc.entity" as entity;
import "core.mc.text" as text;
import "core.io" as io;
import "core.list" as list;
import "core.map" as map;

// Contapassi - a single-file app.
//
// Keeps count of what each player does, shows it above the hotbar, and saves it to disk.
// Shows: module state with 'let mut', event handlers, HUD, persistence, and a public
// function that the admin calls from the console.

// --- state ---------------------------------------------------------------------------------

// 'let mut' and not a bare assignment: this is how the functions below see it
let mut conteggi = {};          // player name -> {'salti' -> n, 'rotti' -> n, 'morti' -> n}
let mut tick_passati = 0;

let SALVA_OGNI = 6000;          // ticks, i.e. five minutes
let VOCI = ['salti', 'rotti', 'morti'];

// --- reading and writing state -------------------------------------------------------

fn scheda(giocatore) -> (
    nome = entity.query(giocatore, 'name');
    // a key that doesn't exist is null, and '||' returns the first truthy operand
    if(!map.has(conteggi, nome), conteggi:nome = {'salti' -> 0, 'rotti' -> 0, 'morti' -> 0});
    conteggi:nome
);

fn aggiungi(giocatore, voce) -> (
    s = scheda(giocatore);
    s:voce = s:voce + 1;
    mostra(giocatore, s);
    false                       // the events below must not be cancelled
);

fn mostra(giocatore, s) -> text.hud(
    giocatore,
    text.format('g salti ', 'w ' + s:'salti', 'g   rotti ', 'w ' + s:'rotti', 'g   morti ', 'w ' + s:'morti')
);

// --- persistence ---------------------------------------------------------------------------

// The data lives under the 'data' root, which exists on every server: a subfolder with the app's
// name, so two apps don't step on each other. The check with 'exists' matters: reading a file
// that doesn't exist is an 'io_exception', not a null.
let FILE = 'contapassi/conteggi.json';

fn carica() -> conteggi = if(io.exists('data', FILE), io.read_json('data', FILE), {});

fn salva() -> (
    io.write_json('data', FILE, conteggi);
    false
);

// --- handlers -------------------------------------------------------------------------------

fn su_salto(giocatore) -> aggiungi(giocatore, 'salti');
fn su_rottura(giocatore, blocco) -> aggiungi(giocatore, 'rotti');
fn su_morte(giocatore) -> aggiungi(giocatore, 'morti');

fn su_arrivo(giocatore) -> (
    mostra(giocatore, scheda(giocatore));
    false
);

// Saving only on shutdown isn't enough: a server that crashes doesn't call any handler.
fn su_tick() -> (
    tick_passati += 1;
    if(tick_passati % SALVA_OGNI == 0, salva());
    false
);

// --- interface for admins ---------------------------------------------------------

// /blossom script in contapassi classifica('rotti')
pub fn classifica(voce: str) -> (
    // '~' returns the index, or null if it's not there: compare it with null and don't use it as a
    // condition, because the index of the first element is 0, which is falsy
    if((VOCI ~ voce) == null, throw('voce sconosciuta: ' + voce + ', prova ' + list.join('/', VOCI)));
    righe = list.sort(map.pairs(conteggi), -((_:1):voce));
    list.map(righe, _:0 + ': ' + (_:1):voce)
);

// /blossom script in contapassi azzera()
pub fn azzera() -> (
    conteggi = {};
    salva();
    'azzerato'
);

// --- startup ------------------------------------------------------------------------------------

carica();

event.on('player_jumps', su_salto);
event.on('player_breaks_block', su_rottura);
event.on('player_dies', su_morte);
event.on('player_connects', su_arrivo);
event.on('tick', su_tick);
event.on('server_shuts_down', salva);

print('contapassi pronta, ' + map.size(conteggi) + ' schede in archivio');
