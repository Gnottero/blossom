module torre.registro;

import "core.list" as list;

// Lo stato del registro e' privato e mutabile: fuori da qui si passa solo per le funzioni pubbliche,
// quindi nessun altro modulo puo' lasciarlo in uno stato incoerente.
let mut torri = [];

pub fn aggiungi(base, altezza) -> (
    list.put(torri, null, [base, altezza]);
    list.size(torri)
);

pub fn tutte() -> torri;

pub fn quante() -> list.size(torri);

pub fn svuota() -> (
    torri = [];
    0
);
