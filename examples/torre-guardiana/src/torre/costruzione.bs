module torre.costruzione;

import "core.mc.block" as block;
import "core.list" as list;
import "core.math" as math;

// The tower's material lives here and not in main: whoever changes how the construction looks
// doesn't need to go read the event logic.
let materiale = 'stone_bricks';
let materiale_cima = 'sea_lantern';

// Private: it's a detail of how things get built, not something other modules should be able to use.
fn colonna(x, y, z, altezza, blocco) -> (
    list.map(list.range(altezza), block.set([x, y + _, z], blocco));
    altezza
);

pub fn costruisci(base, altezza) -> (
    x = base:0;
    y = base:1;
    z = base:2;
    colonna(x, y, z, altezza, materiale);
    block.set([x, y + altezza, z], materiale_cima);
    altezza + 1
);

pub fn smonta(base, altezza) -> (
    colonna(base:0, base:1, base:2, altezza + 1, 'air');
    true
);

pub fn altezza_consigliata(luce) -> math.max(4, 16 - luce);
