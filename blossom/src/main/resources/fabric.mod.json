{
  "schemaVersion": 1,
  "id": "blossomscript",
  "version": "${version}",
  "name": "Blossom",
  "description": "Un linguaggio di scripting per Minecraft: moduli veri, errori leggibili, e una API di gioco curata.",
  "authors": [
    "Gnottero"
  ],
  "contact": {
    "sources": "https://github.com/Gnottero/fabric-carpet"
  },
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.gnottero.blossom.BlossomMod::onGameStarted"
    ],
    "client": [
      "com.gnottero.blossom.client.BlossomClient::onClientStarted"
    ]
  },
  "mixins": [
    "blossomscript.mixins.json",
    {
      "config": "blossomscript.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "minecraft": ">26.3",
    "fabricloader": ">=0.19.5",
    "java": ">=25"
  },
  "accessWidener": "blossom.accesswidener"
}