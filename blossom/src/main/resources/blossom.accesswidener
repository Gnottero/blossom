accessWidener	v1	official

# the nested classes the API has to be able to name
accessible class net/minecraft/world/level/biome/Biome$ClimateSettings
accessible class net/minecraft/server/MinecraftServer$ReloadableResources
accessible class net/minecraft/world/level/NaturalSpawner$SpawnState

# to draw a block outside the world: it is the resolver that can give a block state a model
accessible field net/minecraft/client/renderer/blockentity/BlockEntityRenderDispatcher blockModelResolver Lnet/minecraft/client/renderer/block/BlockModelResolver;

# the name of whoever runs a command, which run() has to keep
accessible field net/minecraft/commands/CommandSourceStack namesProvider Lnet/minecraft/commands/CommandSourceStack$NamesProvider;

# the data of a block written in a command, for the <block> arguments of apps
accessible field net/minecraft/commands/arguments/blocks/BlockInput tag Lnet/minecraft/nbt/CompoundTag;

# i ticket di caricamento dei chunk, per world.chunk_tickets
accessible field net/minecraft/server/level/ServerChunkCache ticketStorage Lnet/minecraft/world/level/TicketStorage;
